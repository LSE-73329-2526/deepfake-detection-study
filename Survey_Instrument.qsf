,5],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionID":"QID70","DisplayLogic":{"0":{"0":{"LogicType":"EmbeddedField","LeftOperand":"HideQuestion","Operator":"EqualTo","RightOperand":"1","Type":"Expression","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"LeftOpDesc\">HideQuestion<\/span> <span class=\"OpDesc\">Is Equal to<\/span> <span class=\"RightOpDesc\"> 1 <\/span>"},"Type":"If"},"Type":"BooleanExpression","inPage":false}}},{"SurveyID":"SV_3Kjf1YX6WSudGEm","Element":"SQ","PrimaryAttribute":"QID71","SecondaryAttribute":"The following section asks about how you use social media in your daily life. Please select the r...","TertiaryAttribute":null,"Payload":{"QuestionText":"The following section asks about how you use social media in your daily life. Please select the response that best applies to you for each question.","DefaultChoices":false,"DataExportTag":"Q71","QuestionID":"QID71","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"The following section asks about how you use social media in your daily life. Please select the r...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1}},{"SurveyID":"SV_3Kjf1YX6WSudGEm","Element":"SQ","PrimaryAttribute":"QID72","SecondaryAttribute":"Before continuing, please answer the following two questions.","TertiaryAttribute":null,"Payload":{"QuestionText":"Before continuing, please answer the following two questions.","DefaultChoices":false,"DataExportTag":"Q72","QuestionID":"QID72","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Before continuing, please answer the following two questions.","ChoiceOrder":[],"Validat